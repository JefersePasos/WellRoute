@model List<WellRoute.Models.Dtos.DestinoListaDto>

@{
    ViewData["Title"] = "Gestión de destinos";
    var esAdministrador = User.IsInRole("Administrador");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Gestión de destinos</h1>
    <a asp-action="Crear" class="btn btn-primary">Nuevo destino</a>
</div>

@if (ViewBag.Error is string errorCarga)
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>País</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var destino in Model)
            {
                <tr>
                    <td><img class="thumb-destino" src="@destino.ImagenUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /></td>
                    <td>@destino.Nombre</td>
                    <td>@destino.Pais</td>
                    <td>@destino.Categoria</td>
                    <td>
                        @if (destino.Activo)
                        {
                            <span class="badge bg-success">Publicado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Oculto</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@destino.DestinoID"
                           class="btn btn-sm btn-outline-primary">Editar</a>

                        @if (esAdministrador)
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@destino.DestinoID"
                                  method="post" class="d-inline">
                                <input type="hidden" name="activo" value="@((!destino.Activo).ToString().ToLowerInvariant())" />
                                <button type="submit"
                                        class="btn btn-sm @(destino.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(destino.Activo ? "Ocultar" : "Publicar")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">Todavía no hay destinos. Crea el primero.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

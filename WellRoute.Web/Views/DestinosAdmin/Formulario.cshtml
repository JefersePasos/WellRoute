@model WellRoute.Web.Models.DestinoFormViewModel

@{
    var esEdicion = Model.DestinoID.HasValue;
    ViewData["Title"] = esEdicion ? "Editar destino" : "Nuevo destino";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="mb-3">@ViewData["Title"]</h1>

        <form asp-action="@(esEdicion ? "Editar" : "Crear")" asp-route-id="@Model.DestinoID" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Pais" class="form-label"></label>
                    <input asp-for="Pais" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Pais" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Categoria" class="form-label"></label>
                <select asp-for="Categoria" class="form-select">
                    <option value="">Selecciona una categoría</option>
                    @foreach (var categoria in Model.CategoriasDisponibles)
                    {
                        <option value="@categoria">@categoria</option>
                    }
                </select>
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImagenUrl" class="form-label"></label>
                <input asp-for="ImagenUrl" class="form-control" autocomplete="off" placeholder="https://..." />
                <span asp-validation-for="ImagenUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VideoUrl" class="form-label"></label>
                <input asp-for="VideoUrl" class="form-control" autocomplete="off" placeholder="https://..." />
                <span asp-validation-for="VideoUrl" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

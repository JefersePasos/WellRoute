@model WellRoute.Web.Models.PortadaViewModel

@{
    ViewData["Title"] = "Destinos";
    var retorno = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="text-center my-4">
    <h1 class="display-5">¿A dónde quieres ir?</h1>
    <p class="text-muted">Elige un destino y descubre todo lo que puedes hacer allí.</p>
</div>

<form method="get" asp-controller="Home" asp-action="Index" class="row g-2 justify-content-center mb-4">
    <div class="col-12 col-md-5">
        <input type="search" name="buscar" value="@Model.Buscar" maxlength="100"
               class="form-control" placeholder="Ej.: Quiero ir a París" aria-label="Buscar destino" />
    </div>
    <div class="col-12 col-md-3">
        <select name="categoria" class="form-select" aria-label="Categoría">
            <option value="">Todas las categorías</option>
            @foreach (var categoria in Model.Categorias)
            {
                <option value="@categoria" selected="@(categoria == Model.Categoria)">@categoria</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (Model.HayFiltros)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

@if (Model.Destinos.Count == 0 && Model.Error is null)
{
    <p class="text-center text-muted">
        @(Model.HayFiltros
            ? "No encontramos destinos con esa búsqueda. Prueba con otra palabra o quita el filtro."
            : "Todavía no hay destinos publicados.")
    </p>
}
else
{
    <div class="collage">
        @foreach (var destino in Model.Destinos)
        {
            <partial name="_TarjetaDestino" model="@(new WellRoute.Web.Models.TarjetaDestinoViewModel
            {
                Destino = destino,
                MostrarFavorito = Model.PuedeFavoritos,
                EsFavorito = Model.FavoritosIds.Contains(destino.DestinoID),
                ReturnUrl = retorno
            })" />
        }
    </div>
}

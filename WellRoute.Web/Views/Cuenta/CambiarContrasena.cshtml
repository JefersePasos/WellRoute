@model WellRoute.Web.Models.CambiarContrasenaViewModel

@{
    ViewData["Title"] = "Cambiar contraseña temporal";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-3">Cambia tu contraseña temporal</h1>
        <p>Antes de continuar, define una contraseña nueva para tu cuenta.</p>

        <form asp-controller="Cuenta" asp-action="CambiarContrasena"
              method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="ContrasenaActual" class="form-label"></label>
                <input asp-for="ContrasenaActual" type="password" class="form-control"
                       autocomplete="current-password" />
                <span asp-validation-for="ContrasenaActual" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContrasenaNueva" class="form-label"></label>
                <input asp-for="ContrasenaNueva" type="password" class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="ContrasenaNueva" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Confirmacion" class="form-label"></label>
                <input asp-for="Confirmacion" type="password" class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="Confirmacion" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar contraseña</button>
        </form>

        <form asp-controller="Cuenta" asp-action="CerrarSesion"
              method="post" asp-antiforgery="true" class="mt-3">
            <button type="submit" class="btn btn-outline-secondary">Cancelar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

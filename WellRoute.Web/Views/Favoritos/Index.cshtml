@model List<WellRoute.Models.Dtos.DestinoListaDto>

@{
    ViewData["Title"] = "Mis favoritos";
    var retorno = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<h1 class="my-4">Mis favoritos</h1>

@if (ViewBag.Error is string errorCarga)
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
}

@if (Model.Count == 0 && ViewBag.Error is null)
{
    <p class="text-muted">
        Todavía no guardaste ningún destino.
        <a asp-controller="Home" asp-action="Index">Explora los destinos</a> y toca el corazón para guardarlos aquí.
    </p>
}
else
{
    <div class="collage">
        @foreach (var destino in Model)
        {
            <partial name="_TarjetaDestino" model="@(new WellRoute.Web.Models.TarjetaDestinoViewModel
            {
                Destino = destino,
                MostrarFavorito = true,
                EsFavorito = true,
                ReturnUrl = retorno
            })" />
        }
    </div>
}

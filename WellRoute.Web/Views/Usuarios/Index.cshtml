@model List<WellRoute.Models.Dtos.UsuarioListaDto>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Usuarios</h1>
    <a asp-action="Crear" class="btn btn-primary">Nuevo usuario</a>
</div>

@if (ViewBag.Error is string errorCarga)
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Roles</th>
                <th>Estado</th>
                <th>Último acceso</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Email</td>
                    <td>@string.Join(", ", usuario.Roles)</td>
                    <td>
                        @if (usuario.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>@(usuario.FechaUltimoLogin?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@usuario.UsuarioID"
                           class="btn btn-sm btn-outline-primary">Editar</a>

                        <form asp-action="RestablecerContrasena" asp-route-id="@usuario.UsuarioID"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Se generará una contraseña temporal nueva para este usuario. ¿Continuar?');">
                            <button type="submit" class="btn btn-sm btn-outline-warning">Restablecer contraseña</button>
                        </form>

                        <form asp-action="CambiarEstado" asp-route-id="@usuario.UsuarioID"
                              method="post" class="d-inline">
                            <input type="hidden" name="activo" value="@((!usuario.Activo).ToString().ToLowerInvariant())" />
                            <button type="submit"
                                    class="btn btn-sm @(usuario.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(usuario.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay usuarios para mostrar.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
